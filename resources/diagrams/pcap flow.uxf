Match against alerts where:
src_ip = packet.src_ip AND
dest_ip = packet.dest_ip AND
timestamp between
	packet.time - 5s AND
	packet.time + 5s </panel_attributes><additional_attributes></additional_attributes></element><element><id>Relation</id><coordinates><x>279</x><y>455</y><w>27</w><h>63</h></coordinates><panel_attributes>lt=&lt;&lt;-</panel_attributes><additional_attributes>10;50;10;10</additional_attributes></element><element><id>UMLClass</id><coordinates><x>216</x><y>500</y><w>189</w><h>99</h></coordinates><panel_attributes>halign=left
